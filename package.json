    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pretendard": "^1.3.9",
    "rehype-slug": "^6.0.0",
    "serve": "14.2.8",
